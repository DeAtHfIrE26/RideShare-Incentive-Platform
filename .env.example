# Copy to .env and fill in real values. .env is gitignored; never commit it.

# PostgreSQL connection string. A neon.tech host connects over the Neon
# WebSocket driver; any other host connects over TCP with node-postgres, so a
# local URL such as postgresql://postgres@127.0.0.1:5432/rideshare also works.
# Required by: server/db.ts, server/migrate.ts, drizzle.config.ts
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secret used to sign express-session cookies. Generate a random value, e.g.
# `openssl rand -hex 32`. Changing it invalidates all existing sessions.
# Required by: server/auth.ts
SESSION_SECRET=replace-with-a-random-32-byte-hex-string

# Runtime mode. "development" enables the Vite dev middleware and an in-memory
# DB fallback; "production" serves the prebuilt client and fails hard on DB errors.
# Required by: server/index.ts, server/db.ts
NODE_ENV=development
